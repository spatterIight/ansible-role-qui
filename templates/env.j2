TZ={{ qui_environment_variables_tz }}

{#
qui writes a config.toml into its config directory on first start and reads
its listen address out of it from then on. Its `QUI__*` environment variables
override that file at runtime, which is what lets this role stay authoritative
about where qui listens instead of depending on a file it does not manage.

Without these, `qui_container_http_port` would only relabel the published port
and the Traefik service, while qui itself kept listening on whatever its own
config.toml said - so any value other than the default of 7476 would point the
proxy at a port nothing is bound to.
#}
QUI__HOST=0.0.0.0
QUI__PORT={{ qui_container_http_port }}

{#
qui serves its web UI, its API and its qBittorrent proxy under the base URL,
so the reverse-proxy passes the path prefix through rather than stripping it
(see `labels.j2`). qui normalizes the value itself (`/qui` becomes `/qui/`).
#}
QUI__BASE_URL={{ qui_path_prefix }}

QUI__SESSION_COOKIE_SECURE={{ qui_environment_variables_qui_session_cookie_secure | bool | to_json }}

{{ qui_environment_variables_additional_variables }}
